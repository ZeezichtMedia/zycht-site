---
---

<section class="relative bg-primary-dark text-white overflow-hidden">
  <!-- Background Pattern/Image Overlay -->
  <div class="absolute inset-0 opacity-10 bg-[url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80')] bg-cover bg-center"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-primary-dark via-primary/90 to-primary/80"></div>

  <div class="container-custom mx-auto relative z-10 py-24 md:py-32 lg:py-40">
    <div class="max-w-3xl">
      <h1 class="font-heading font-bold text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight text-white">
        Een goed <span class="text-accent">vooruitzicht</span> voor u en uw bedrijf
      </h1>
      <p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed max-w-2xl">
        ZYCHT helpt MKB-ondernemers verder in elke fase van het ondernemerschap met onafhankelijk advies, bedrijfsfinanciering en financiële coaching.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="btn btn-accent text-lg">
          Vrijblijvend kennismaken
        </a>
        <a href="/diensten" class="btn btn-outline border-white text-white hover:bg-white hover:text-primary text-lg">
          Onze diensten
        </a>
      </div>
    </div>
  </div>
</section>
