---
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white pt-16 pb-8">
  <div class="container-custom mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- Brand & About -->
      <div>
        <a href="/" class="text-3xl font-heading font-bold text-white tracking-tight mb-4 block">
          ZYCHT<span class="text-accent">.</span>
        </a>
        <p class="text-slate-300 mb-6 leading-relaxed">
          Een goed vooruitzicht voor u en uw bedrijf. Wij bieden onafhankelijk advies en financiële coaching voor MKB-ondernemers.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-bold mb-6 text-accent">Diensten</h3>
        <ul class="space-y-3">
          <li><a href="/diensten/bedrijfsfinanciering" class="text-slate-300 hover:text-white transition-colors">Bedrijfsfinanciering</a></li>
          <li><a href="/diensten/bedrijfsadvisering" class="text-slate-300 hover:text-white transition-colors">Bedrijfsadvisering</a></li>
          <li><a href="/diensten/financiele-planning" class="text-slate-300 hover:text-white transition-colors">Financiële Planning</a></li>
          <li><a href="/diensten/administratieve-dienstverlening" class="text-slate-300 hover:text-white transition-colors">Administratieve Dienstverlening</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-xl font-bold mb-6 text-accent">Contact</h3>
        <ul class="space-y-4 text-slate-300">
          <li class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-3 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Lamoenenhof 1<br/>5371 DD Ravenstein</span>
          </li>
          <li class="flex items-center">
