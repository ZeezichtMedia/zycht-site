---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Neem contact op met ZYCHT voor een vrijblijvend kennismakingsgesprek.">
  <section class="bg-primary text-white py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-primary-dark to-primary opacity-90"></div>
    <div class="container-custom mx-auto relative z-10">
      <h1 class="text-4xl md:text-5xl mb-4 text-white">Contact</h1>
      <p class="text-xl text-slate-300 max-w-2xl">
        Klaar voor een goed vooruitzicht? Laten we kennismaken.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Contact Info -->
        <div>
          <h2 class="text-primary font-heading mb-6">Gegevens</h2>
          <p class="text-slate-600 mb-8 leading-relaxed">
            Heeft u een vraag of wilt u een afspraak maken? Bel, mail of vul het contactformulier in. 
            Ik neem zo snel mogelijk contact met u op.
          </p>

          <div class="space-y-6">
            <div class="flex items-start">
              <div class="w-12 h-12 bg-primary/5 rounded-lg flex items-center justify-center text-accent shrink-0 mr-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-primary mb-1">Adres</h3>
                <p class="text-slate-600">Lamoenenhof 1<br/>5371 DD Ravenstein</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-primary/5 rounded-lg flex items-center justify-center text-accent shrink-0 mr-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-primary mb-1">Telefoon</h3>
                <a href="tel:0619037986" class="text-slate-600 hover:text-accent transition-colors">06 - 1903 7986</a>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-primary/5 rounded-lg flex items-center justify-center text-accent shrink-0 mr-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-primary mb-1">E-mail</h3>
                <a href="mailto:info@zycht.nl" class="text-slate-600 hover:text-accent transition-colors">info@zycht.nl</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-white p-8 rounded-xl shadow-lg border border-slate-100">
          <h2 class="text-2xl font-bold text-primary mb-6">Stuur een bericht</h2>
          <form class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Naam</label>
                <input type="text" id="name" name="name" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none transition-all" placeholder="Uw naam" required />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">E-mail</label>
                <input type="email" id="email" name="email" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none transition-all" placeholder="uw@email.nl" required />
              </div>
            </div>
            
            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">Telefoonnummer (optioneel)</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none transition-all" placeholder="06 12345678" />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-slate-700 mb-1">Bericht</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-accent outline-none transition-all" placeholder="Waarmee kunnen we u helpen?" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-full">Verstuur bericht</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
