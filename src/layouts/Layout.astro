---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Een goed vooruitzicht voor u en uw bedrijf. ZYCHT biedt onafhankelijk advies en financiële coaching voor MKB-ondernemers." } = Astro.props;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | ZYCHT Advies & Financial Coaching</title>
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow pt-20">
			<slot />
		</main>
		<Footer />
	</body>
</html>
