---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Een goed vooruitzicht voor u en uw bedrijf. ZYCHT biedt onafhankelijk advies en financiële coaching voor MKB-ondernemers." } = Astro.props;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title} | ZYCHT Advies & Financial Coaching</title>
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow pt-20">
			<slot />
		</main>
		<Footer />
	</body>
</html>
